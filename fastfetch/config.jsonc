{
  "logo": {
    "type": "kitty",
    "source": "/root/Images/linus-f-nvidia.png",
    "width": 30,
    "height": 15
  },
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "bright_black"
    },
    "break",
    { "type": "os",       "key": "\uf17c \u001b[32m➜\u001b[0m " },
    { "type": "kernel",   "key": "\uf013 \u001b[32m➜\u001b[0m " },
    { "type": "uptime",   "key": "\uf017 \u001b[32m➜\u001b[0m " },
    { "type": "shell",    "key": "\uf120 \u001b[32m➜\u001b[0m " },
    { "type": "terminal", "key": "\uf108 \u001b[32m➜\u001b[0m " },
    "break",
    {
      "type": "separator",
      "string": "─",
      "outputColor": "bright_black"
    },
    "break",
    { "type": "cpu",    "key": "\uf2db \u001b[32m➜\u001b[0m " },
    { "type": "gpu",    "key": "\uf26c \u001b[32m➜\u001b[0m ", "format": "{2}" },
    { "type": "memory", "key": "\uf233 \u001b[32m➜\u001b[0m " },
    { "type": "disk",   "key": "\uf0a0 \u001b[32m➜\u001b[0m " }
  ],
  "display": {
    "separator": "",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  }
}

