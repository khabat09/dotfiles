syntax on
filetype plugin indent on

set number
set encoding=utf-8
set mouse=a
set clipboard=unnamedplus

set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set wrap
set linebreak
set scrolloff=5
set ruler
set wildmenu
set hidden
set backspace=indent,eol,start
